/// 지점 폐점 처리 이력
model BranchClosureLog {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  branchId           Int
  announcedAt        DateTime // 폐점 공지 일시
  closingDate        DateTime // 폐점 예정일
  totalMembers       Int      @default(0) // 대상 회원 수
  transferredMembers Int      @default(0) // 이관 완료 회원 수
  refundedMembers    Int      @default(0) // 환불 처리 회원 수
  totalStaff         Int      @default(0) // 대상 직원 수
  status             String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  createdBy          Int      // 처리 담당 사용자 ID
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@map("branch_closure_log")
}

// ============================================================
// OnFit GAP Phase 1 - 신규 모델
// ============================================================

/// 회원 신체정보 (키/몸무게/혈압 등 기본 신체 측정)
model MemberBodyInfo {
  id            Int       @id @default(autoincrement())
  memberId      Int
  height        Decimal?  @db.Decimal(5, 1) // 키 (cm)
  weight        Decimal?  @db.Decimal(5, 1) // 몸무게 (kg)
  bloodPressure String?   // 혈압 (120/80 형태)
  heartRate     Int?      // 심박수
  notes         String?
  measuredAt    DateTime  @default(now())
  branchId      Int
  createdAt     DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([branchId])
  @@map("member_body_info")
}

/// 회원 종합평가 (트레이너 평가)
model MemberEvaluation {
  id          Int      @id @default(autoincrement())
  memberId    Int
  staffId     Int      // 평가 작성 트레이너
  staffName   String   // 비정규화
  category    String?  // 체력, 자세, 유연성, 목표달성 등
  score       Int?     // 1~10 점수
  content     String   // 평가 내용
  branchId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([branchId])
  @@map("member_evaluations")
}

/// 상담 이력
model Consultation {
  id          Int       @id @default(autoincrement())
  memberId    Int
  staffId     Int       // 상담 담당자
  staffName   String    // 비정규화
  type        String    // 상담, OT, 체험, 재등록상담
  content     String
  result      String?   // 등록, 미등록, 보류
  nextAction  String?   // 후속 액션 메모
  linkedSaleId Int?     // 연결된 매출 ID
  scheduledAt DateTime? // 예정 일시
  completedAt DateTime? // 완료 일시
  status      String    @default("scheduled") // scheduled, completed, cancelled, no_show
  inquiryType String?   // WI(방문문의) | TI(전화문의) | null(미분류)
  source      String?   // 가입경로: 체험|일일입장|소개|온라인|현수막|간판|재등록|기타
  branchId    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([branchId])
  @@index([staffId])
  @@map("consultations")
}

/// 운동 프로그램 템플릿
model ExerciseProgram {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category    String?  // 근력, 유산소, 유연성, 재활 등
  difficulty  String?  // 초급, 중급, 고급
  exercises   Json?    // [{name, sets, reps, weight, duration, notes}]
  isActive    Boolean  @default(true)
  branchId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  memberPrograms MemberExerciseProgram[]

  @@index([branchId])
  @@map("exercise_programs")
}

/// 회원별 운동 프로그램 배정
model MemberExerciseProgram {
  id         Int       @id @default(autoincrement())
  memberId   Int
  programId  Int
  assignedBy Int       // 배정한 트레이너 ID
  assignedAt DateTime  @default(now())
  expiresAt  DateTime? // 프로그램 만료일
  status     String    @default("active") // active, completed, cancelled
  branchId   Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  member  Member          @relation(fields: [memberId], references: [id])
  program ExerciseProgram @relation(fields: [programId], references: [id])

  @@index([memberId])
  @@index([programId])
  @@index([branchId])
  @@map("member_exercise_programs")
}

/// 운동 이력 기록
model ExerciseLog {
  id           Int       @id @default(autoincrement())
  memberId     Int
  programId    Int?      // 연결된 프로그램 (선택)
  exerciseName String    // 운동 이름
  sets         Int?      // 세트 수
  reps         Int?      // 반복 횟수
  weight       Decimal?  @db.Decimal(5, 1) // 무게 (kg)
  duration     Int?      // 시간 (분)
  distance     Decimal?  @db.Decimal(7, 2) // 거리 (km)
  notes        String?
  loggedAt     DateTime  @default(now())
  branchId     Int
  createdAt    DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([branchId])
  @@index([loggedAt])
  @@map("exercise_logs")
}

/// 그룹수업 템플릿 (수업 사전 정의)
model ClassTemplate {
  id              Int      @id @default(autoincrement())
  name            String   // 템플릿 이름
  type            String   // GX, PT, 필라테스, 요가 등
  defaultCapacity Int      @default(14) // 기본 정원
  defaultDuration Int      @default(50) // 기본 시간 (분)
  description     String?
  color           String?  // 캘린더 표시 색상
  isActive        Boolean  @default(true)
  branchId        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([branchId])
  @@map("class_templates")
}

/// 직원 근태 기록
model StaffAttendanceRecord {
  id        Int       @id @default(autoincrement())
  staffId   Int
  staffName String    // 비정규화
  date      DateTime  @db.Date
  clockIn   DateTime?
  clockOut  DateTime?
  status    String    @default("normal") // normal, late, early_leave, absent
  workHours Decimal?  @db.Decimal(4, 1) // 근무 시간
  workMinutes Int?
  source    String    @default("키오스크")
  corrections Json     @default("[]")
  memo      String?
  notes     String?
  branchId  Int
  createdAt DateTime  @default(now())

  @@index([staffId])
  @@index([branchId])
  @@index([branchId, date])
  @@index([clockIn])
  @@map("staff_attendance")
}

/// 할인 정책
model DiscountPolicy {
  id          Int      @id @default(autoincrement())
  name        String   // 할인명
  type        String   // percentage, fixed
  value       Decimal  @db.Decimal(10, 2) // 할인율(%) 또는 할인금액
  minPeriod   Int?     // 최소 계약 기간 (일)
  maxDiscount Decimal? @db.Decimal(10, 0) // 최대 할인금액 (percentage 타입용)
  conditions  Json?    // 추가 조건 (상품유형, 기간 등)
  isActive    Boolean  @default(true)
  branchId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([branchId])
  @@map("discount_policies")
}

/// 시즌 특가
model ProductSeasonalPrice {
  id                 Int      @id @default(autoincrement())
  branchId           Int
  name               String
  productIds         Int[]    @default([])
  productNames       String[] @default([])
  primaryProductId   Int?
  primaryProductName String?
  originalPrice      Decimal  @default(0) @db.Decimal(12, 0)
  discountedPrice    Decimal  @default(0) @db.Decimal(12, 0)
  discountRate       Decimal  @default(0) @db.Decimal(5, 2)
  discountType       String   @default("fixed_price")
  discountValue      Decimal  @default(0) @db.Decimal(12, 2)
  startDate          DateTime @db.Date
  endDate            DateTime @db.Date
  isActive           Boolean  @default(true)
  endedAt            DateTime?
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([branchId])
  @@index([branchId, startDate, endDate])
  @@index([branchId, isActive])
  @@map("product_seasonal_prices")
}

/// 선수익금 (미래 매출 인식)
model DeferredRevenue {
  id               Int      @id @default(autoincrement())
  saleId           Int
  memberId         Int
  memberName       String   // 비정규화
  productName      String?  // 비정규화
  totalAmount      Decimal  @db.Decimal(12, 0)
  recognizedAmount Decimal  @default(0) @db.Decimal(12, 0) // 인식된 매출
  remainingAmount  Decimal  @db.Decimal(12, 0) // 잔여 선수익금
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  branchId         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([branchId])
  @@index([memberId])
  @@map("deferred_revenue")
}

/// 공지사항
model Notice {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  authorId    Int?      // 작성자 (staff ID)
  authorName  String    // 비정규화
  isPinned    Boolean   @default(false) // 고정글
  isPublished Boolean   @default(true)
  publishedAt DateTime?
  targetRoles String[]  @default(["all"])
  publishStart DateTime?
  publishEnd   DateTime?
  branchId    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([branchId])
  @@index([isPinned])
  @@map("notices")
}

/// 공지 읽음 이력
model NoticeReadReceipt {
  id       Int      @id @default(autoincrement())
  branchId Int
  noticeId Int
  userId   Int?
  userName String?
  readAt   DateTime @default(now())

  @@unique([noticeId, userId])
  @@index([branchId, noticeId])
  @@map("notice_read_receipts")
}

/// 상품 분류 (카테고리 그룹)
model ProductGroup {
  id        Int      @id @default(autoincrement())
  name      String   // 분류명
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  branchId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  products Product[]

  @@index([branchId])
  @@map("product_groups")
}
