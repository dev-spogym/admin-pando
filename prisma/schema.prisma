generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN
  OWNER
  MANAGER
  TRAINER
  STAFF
  RECEPTIONIST
  READONLY
}

enum Gender {
  M
  F
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  HOLDING
  SUSPENDED
  WITHDRAWN    // 탈퇴
  DORMANT      // 휴면
  TRANSFERRED  // 타지점 이관
}

enum StaffStatus {
  ACTIVE      // 재직
  RESIGNED    // 퇴사
  TRANSFERRED // 이직/타지점 이관
  ON_LEAVE    // 휴직
  LOCKED      // 계정 잠금
}

enum BranchStatus {
  ACTIVE   // 운영중
  CLOSING  // 폐점 진행중
  INACTIVE // 폐점
  PAUSED   // 일시 중단
}

enum TransferType {
  KEEP_TICKET   // 이용권 유지 이관
  REFUND_NEW    // 환불 후 재등록
  EXHAUST_THEN  // 소진 후 이관
}

enum SettlementStatus {
  PENDING  // 대기
  APPROVED // 승인
  PAID     // 지급 완료
}

enum ProductCategory {
  PT
  MEMBERSHIP
  GX
  PRODUCT
  SERVICE
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
  MILEAGE
  MIXED
}

enum SaleStatus {
  COMPLETED
  UNPAID
  REFUNDED
  REFUND_REQUESTED
  REFUND_PENDING
  REFUND_REJECTED
  PENDING
}

enum AttendanceType {
  REGULAR
  PT
  GX
  MANUAL
}

enum CheckInMethod {
  KIOSK
  APP
  MANUAL
}

enum LockerStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum MessageType {
  SMS
  KAKAO
  PUSH
}

enum MessageStatus {
  SENT
  FAILED
  PENDING
  SCHEDULED
}

enum PayrollStatus {
  PENDING
  PAID
}

// ============================================================
// Models
// ============================================================

/// 테넌트 (헬스장 브랜드 단위)
model Tenant {
  id            Int       @id @default(autoincrement())
  name          String    // 헬스장 브랜드명
  plan          String    @default("BASIC") // BASIC, STANDARD, PREMIUM
  maxBranches   Int       @default(1)
  ownerUserId   Int?
  planExpiresAt DateTime?
  paymentMethod String?   // CARD, BANK_TRANSFER
  overdueDays   Int       @default(0)
  taxInvoiceType String   @default("HQ") // HQ: 본사발행, BRANCH: 지점별 발행
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  branches Branch[]
  users    User[]

  @@map("tenants")
}

/// 지점
model Branch {
  id           Int          @id @default(autoincrement())
  name         String
  address      String?
  phone        String?
  status       String       @default("운영중") // 운영중, 임시휴업
  managerId    Int?
  managerName  String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  // 멀티테넌트 확장 필드
  tenantId     Int          @default(1)          // FK → Tenant
  isHq         Boolean      @default(false)       // 본사 여부
  branchCode   String       @default("")          // 지점 코드 (테넌트 내 고유)
  districtCode String       @default("")          // 지부 코드 (A-1, A-2 등)
  districtName String       @default("")          // 지부명 (1지부, 2지부 등)
  branchStatus BranchStatus @default(ACTIVE)      // 상세 운영 상태
  maxMembers   Int?                               // 최대 회원 수 제한
  maxStaff     Int?                               // 최대 직원 수 제한
  maxLockers   Int?                               // 최대 락커 수 제한
  pausedAt     DateTime?                          // 일시 중단 일시
  resumeAt     DateTime?                          // 재개 예정 일시

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  members    Member[]
  staff      Staff[]
  products   Product[]
  sales      Sale[]
  attendance Attendance[]
  lockers    Locker[]
  messages   Message[]
  settings   Settings?
  classes    Class[]
  coupons    Coupon[]
  users      User[]
  installmentContracts InstallmentContract[]
  taxInvoices TaxInvoice[]
  salesForecastTargets SalesForecastTarget[]

  @@map("branches")
}

/// 사용자 (로그인 계정)
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  email     String?
  role      Role     @default(STAFF)
  branchId  Int?     // 슈퍼관리자는 NULL 가능
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // 멀티테넌트 확장 필드
  tenantId            Int       @default(1)         // FK → Tenant
  isSuperAdmin        Boolean   @default(false)      // 슈퍼관리자 여부
  currentBranchId     Int?                           // 슈퍼관리자 현재 선택 지점
  passwordChangedAt   DateTime?                      // 마지막 비밀번호 변경 일시
  forcePasswordChange Boolean   @default(true)       // 최초 로그인 시 비밀번호 변경 강제
  loginFailCount      Int       @default(0)          // 로그인 실패 횟수
  lockedUntil         DateTime?                      // 계정 잠금 해제 일시
  lastLoginAt         DateTime?                      // 마지막 로그인 일시

  branch Branch? @relation(fields: [branchId], references: [id])
  tenant Tenant  @relation(fields: [tenantId], references: [id])

  @@map("users")
}

/// 회원
model Member {
  id               Int          @id @default(autoincrement())
  name             String
  phone            String
  email            String?
  gender           Gender?
  birthDate        DateTime?
  profileImage     String?
  registeredAt     DateTime     @default(now())
  membershipType   String?      // PT, MEMBERSHIP, GX
  membershipStart  DateTime?
  membershipExpiry DateTime?
  status           MemberStatus @default(ACTIVE)
  mileage          Int          @default(0)
  memo             String?
  height           Float?       // 키 (cm)
  deletedAt        DateTime?    // soft delete
  staffId          Int?         // 담당 FC
  branchId         Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  // 멀티테넌트 확장 필드
  homeBranchId     Int?         // 다지점 이용 시 주 지점
  withdrawnAt      DateTime?    // 탈퇴 일시
  withdrawReason   String?      // 탈퇴 사유
  privacyMaskedAt  DateTime?    // 개인정보 마스킹 처리 일시
  previousMemberId Int?         // 재가입 시 이전 회원 ID

  // OnFit GAP 확장 필드
  memberType       String?      @default("individual") // individual, named_corporate, unnamed_corporate
  referralSource   String?      // 유입경로 (홈페이지, 지인소개, 네이버, 인스타 등)
  isFavorite       Boolean      @default(false) // 관심회원 ★
  lastVisitAt      DateTime?    // 최근 방문일 (미방문 N일 필터용)
  companyName      String?      // 법인 회사명

  branch     Branch       @relation(fields: [branchId], references: [id])
  staff      Staff?       @relation("MemberStaff", fields: [staffId], references: [id])
  sales      Sale[]
  attendance Attendance[]
  locker     Locker?
  bodyComps  BodyComposition[]
  contracts  Contract[]
  installmentContracts InstallmentContract[]
  taxInvoices TaxInvoice[]
  memos      MemberMemo[]
  goals      MemberGoal[]
  bodyInfos         MemberBodyInfo[]
  evaluations       MemberEvaluation[]
  consultations     Consultation[]
  exercisePrograms  MemberExerciseProgram[]
  exerciseLogs      ExerciseLog[]
  representativeFamilyGroups MemberFamilyGroup[] @relation("FamilyRepresentative")
  familyMemberships MemberFamilyMember[]
  mergeLogsAsPrimary MemberMergeLog[]

  @@map("members")
}

/// 가족 회원 그룹
model MemberFamilyGroup {
  id                     BigInt   @id @default(autoincrement())
  branchId               Int
  name                   String
  representativeMemberId Int?
  representativeName     String
  memo                   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  representative Member?              @relation("FamilyRepresentative", fields: [representativeMemberId], references: [id], onDelete: SetNull)
  members        MemberFamilyMember[]

  @@index([branchId])
  @@map("member_family_groups")
}

/// 가족 회원 구성원
model MemberFamilyMember {
  id               BigInt   @id @default(autoincrement())
  groupId          BigInt
  memberId         Int?
  memberName       String
  relationship     String   @default("기타")
  isRepresentative Boolean  @default(false)
  joinedAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  group  MemberFamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@map("member_family_members")
}

/// 회원 병합 이력
model MemberMergeLog {
  id                BigInt   @id @default(autoincrement())
  primaryMemberId   Int
  secondaryMemberId Int
  branchId          Int
  mergedBy          String?
  mergedAt          DateTime @default(now())
  detail            Json     @default("{}")

  primaryMember Member @relation(fields: [primaryMemberId], references: [id], onDelete: Cascade)

  @@index([primaryMemberId])
  @@index([secondaryMemberId])
  @@map("member_merge_logs")
}

/// 체성분 기록
model BodyComposition {
  id        Int      @id @default(autoincrement())
  memberId  Int
  date      DateTime @default(now())
  weight    Float?
  muscle    Float?
  fat       Float?
  fatRate   Float?
  bmi       Float?
  memo      String?
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@map("body_compositions")
}

/// 회원 메모
model MemberMemo {
  id        Int      @id @default(autoincrement())
  memberId  Int
  content   String
  category  String?  // 상담, 불만, 일반, 건강
  author    String?  // 작성자명
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@map("member_memos")
}

/// 회원 목표
model MemberGoal {
  id         Int      @id @default(autoincrement())
  memberId   Int      @unique
  goalWeight Float?   // 목표 체중 (kg)
  goalPbf    Float?   // 목표 체지방률 (%)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@map("member_goals")
}

/// 직원
model Staff {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  role      String   // 트레이너, 지점장, 프론트
  position  String?
  hireDate  DateTime?
  salary    Decimal?
  color     String?  // 캘린더 표시 색상
  isActive  Boolean  @default(true)
  branchId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // 멀티테넌트 확장 필드
  staffStatus          StaffStatus @default(ACTIVE)  // 상세 재직 상태
  resignedAt           DateTime?                     // 실제 퇴사 일시
  resignReason         String?                       // 퇴사 사유
  resignScheduledAt    DateTime?                     // 예정 퇴사 일시
  previousEmployeeId   Int?                          // 재입사 시 이전 직원 ID
  leaveStartAt         DateTime?                     // 휴직 시작 일시
  leaveEndAt           DateTime?                     // 휴직 종료 예정 일시
  leaveReason          String?                       // 휴직 사유
  loginFailCount       Int         @default(0)       // 로그인 실패 횟수
  lockedUntil          DateTime?                     // 계정 잠금 해제 일시
  lastLoginAt          DateTime?                     // 마지막 로그인 일시
  transferredFromBranchId Int?                       // 이관 전 지점 ID
  transferredAt        DateTime?                     // 이관 처리 일시

  branch  Branch    @relation(fields: [branchId], references: [id])
  sales   Sale[]
  payroll Payroll[]
  classes Class[]
  members Member[]  @relation("MemberStaff")
  documents StaffDocument[]

  @@map("staff")
}

/// 직원 인사 파일 첨부 이력
model StaffDocument {
  id         BigInt   @id @default(autoincrement())
  staffId    Int
  branchId   Int
  docType    String   @default("employment_contract")
  fileName   String
  filePath   String
  fileUrl    String
  mimeType   String?
  fileSize   Int?
  status     String   @default("uploaded")
  memo       String?
  uploadedBy String?
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([branchId, docType])
  @@map("staff_documents")
}

/// 상품/이용권
model Product {
  id          Int             @id @default(autoincrement())
  name        String
  category    ProductCategory
  price       Decimal
  duration    Int?            // 일수
  sessions    Int?            // PT 횟수
  description String?
  isActive    Boolean         @default(true)
  branchId    Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  // OnFit GAP 확장 필드
  classType      String?  // 수업방식 (1:1, 그룹, 혼합)
  deductionType  String?  // 차감방식 (횟수, 기간, 무제한)
  suspendLimit   Int?     // 기간정지 제한 (일)
  dailyUseLimit  Int?     // 일사용 횟수 제한
  productGroupId Int?     // 상품분류 FK
  imageUrl       String?
  imageMimeType  String?
  imageUpdatedAt DateTime?

  branch       Branch        @relation(fields: [branchId], references: [id])
  productGroup ProductGroup? @relation(fields: [productGroupId], references: [id])
  sales        Sale[]
  installmentContracts InstallmentContract[]

  @@map("products")
}

/// 매출/거래
model Sale {
  id            Int           @id @default(autoincrement())
  memberId      Int
  memberName    String        // 비정규화
  productId     Int?
  productName   String?       // 비정규화
  saleDate      DateTime      @default(now())
  type          String        // 이용권, PT, 상품, 기타
  round         String?       // 신규, 재등록, 미수금환수
  quantity      Int           @default(1)
  originalPrice Decimal       @default(0)
  salePrice     Decimal       @default(0)
  discountPrice Decimal       @default(0)
  amount        Decimal
  paymentMethod PaymentMethod @default(CARD)
  paymentType   String?       // 일시불, 할부
  cash          Decimal       @default(0)
  card          Decimal       @default(0)
  mileageUsed   Decimal       @default(0)
  cardCompany   String?
  cardNumber    String?       // 마스킹
  approvalNo    String?
  status        SaleStatus    @default(COMPLETED)
  unpaid        Decimal       @default(0)
  staffId       Int?
  staffName     String?       // 비정규화
  memo          String?
  durationMonths  Int?        // 이용 기간 (개월): 1,3,6,12
  saleCategory    String?     // 법인권|취소재결제|재등록|일반
  receiptIssued   Boolean     @default(true)  // 현금영수증 발급 여부
  penaltyAmount   Decimal     @default(0)     // 위약금 (환불 시)
  originalSaleId  Int?
  refundReason    String?
  refundProcessedBy String?
  refundProcessedAt DateTime?
  branchId      Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  // 멀티테넌트 확장 필드
  assignedFcId  Int?          // 담당 FC (판매자와 별도)

  member  Member   @relation(fields: [memberId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  staff   Staff?   @relation(fields: [staffId], references: [id])
  branch  Branch   @relation(fields: [branchId], references: [id])
  paymentLines SalePaymentLine[]
  unpaidCollections UnpaidCollection[]
  installmentContracts InstallmentContract[]
  taxInvoices TaxInvoice[]
  originalSale Sale? @relation("SaleRefunds", fields: [originalSaleId], references: [id], onDelete: SetNull)
  refundSales  Sale[] @relation("SaleRefunds")

  @@index([originalSaleId])
  @@map("sales")
}

/// 상품별 수납 행 / 환불 배분 행
model SalePaymentLine {
  id                    BigInt        @id @default(autoincrement())
  saleId                Int
  branchId              Int
  memberId              Int
  productId             Int?
  productName           String
  itemKey               String?
  lineType              String        @default("PAYMENT")
  method                PaymentMethod @default(CARD)
  amount                Decimal       @default(0)
  refundedAmount        Decimal       @default(0)
  originalLineId        BigInt?
  approvalNo            String?
  terminalId            String?
  externalTransactionId String?
  bankPayerName         String?
  transferConfirmNo     String?
  cashReceiptIssued     Boolean       @default(false)
  cashReceiptType       String?
  cashReceiptIdentifier String?
  memo                  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @default(now()) @updatedAt

  sale         Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  originalLine SalePaymentLine?  @relation("RefundOriginalPaymentLine", fields: [originalLineId], references: [id], onDelete: SetNull)
  refundLines  SalePaymentLine[] @relation("RefundOriginalPaymentLine")

  @@index([saleId])
  @@index([originalLineId])
  @@index([branchId, memberId])
  @@map("sale_payment_lines")
}

/// 미수금 납부 이력
model UnpaidCollection {
  id                    BigInt        @id @default(autoincrement())
  saleId                Int
  branchId              Int
  memberId              Int
  internalApprovalNo    String
  method                PaymentMethod
  amount                Decimal       @default(0) @db.Decimal(12, 2)
  previousUnpaid        Decimal       @default(0) @db.Decimal(12, 2)
  remainingUnpaid       Decimal       @default(0) @db.Decimal(12, 2)
  paidAt                DateTime      @default(now())
  approvalNo            String?
  terminalId            String?
  externalTransactionId String?
  bankPayerName         String?
  transferConfirmNo     String?
  cashReceiptIssued     Boolean       @default(false)
  cashReceiptType       String?
  cashReceiptIdentifier String?
  memo                  String?
  processedBy           String?
  createdAt             DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([branchId, memberId])
  @@index([paidAt])
  @@map("unpaid_collections")
}

/// 할부결제 계약
model InstallmentContract {
  id                 BigInt   @id @default(autoincrement())
  contractNo         String   @unique
  branchId           Int
  memberId           Int
  memberName         String
  productId          Int?
  productName        String
  source             String   @default("직접 등록")
  sourceSaleId       Int?
  internalApprovalNo String
  prepaidAmount      Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal  @db.Decimal(12, 2)
  roundCount         Int
  status             String   @default("진행중")
  startDueDate       DateTime @db.Date
  refundInProgress   Boolean  @default(false)
  memo               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member     Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  product    Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  sourceSale Sale?               @relation(fields: [sourceSaleId], references: [id], onDelete: SetNull)
  rounds     InstallmentRound[]

  @@index([branchId, memberId])
  @@index([sourceSaleId])
  @@map("installment_contracts")
}

/// 할부 회차 납입 이력
model InstallmentRound {
  id                    BigInt         @id @default(autoincrement())
  contractId            BigInt
  roundNo               Int
  dueDate               DateTime       @db.Date
  amount                Decimal        @db.Decimal(12, 2)
  paidAmount            Decimal        @default(0) @db.Decimal(12, 2)
  status                String         @default("예정")
  paidAt                DateTime?
  method                PaymentMethod?
  approvalNo            String?
  terminalId            String?
  externalTransactionId String?
  bankPayerName         String?
  transferConfirmNo     String?
  cashReceiptIssued     Boolean        @default(false)
  cashReceiptType       String?
  cashReceiptIdentifier String?
  memo                  String?
  processedBy           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @default(now()) @updatedAt

  contract InstallmentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, roundNo])
  @@index([contractId])
  @@index([dueDate, status])
  @@map("installment_rounds")
}

/// 세금계산서 발행 이력
model TaxInvoice {
  id           BigInt   @id @default(autoincrement())
  invoiceNo    String   @unique
  branchId     Int
  saleId       Int
  memberId     Int
  memberName   String
  recipient    String
  bizNo        String
  email        String
  issueDate    DateTime @default(now()) @db.Date
  supplyAmount Decimal  @default(0) @db.Decimal(12, 2)
  vatAmount    Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal  @default(0) @db.Decimal(12, 2)
  status       String   @default("발행 완료")
  emailSentAt  DateTime?
  memo         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sale   Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  member Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items  TaxInvoiceItem[]

  @@index([branchId, issueDate])
  @@map("tax_invoices")
}

